# Chep tep nay thanh .env roi sua cho hop voi may cua ban.
#   cp .env.example .env

# --- cong dua ra ngoai -------------------------------------------------------
# 8080 tren may nay da co dich vu khac dung, nen chon cap cong khac.
WEB_PORT=7100
BACKEND_PORT=7101

# --- dia chi web nhin tu trinh duyet -----------------------------------------
# Chi dung de mo CORS cho ai goi thang API. Ban than trang web khong can dong nay:
# trinh duyet khong goi backend truc tiep bao gio.
PUBLIC_WEB_URL=http://192.168.100.169:7100

# --- kho phim rieng (ZCloud) -------------------------------------------------
# Khong dat khoa vao tep nay neu ban co y dinh chia se no.
ZCLOUD_API_KEY=
ZCLOUD_PASSWORD=
ZCLOUD_PREFIX=
# ZCloud chay tren chinh may chu, khong phai trong Docker.
ZCLOUD_BASE_URL=http://host.docker.internal:8080

# --- trang quan tri ----------------------------------------------------------
# Khoa de them/sua nguon phim tai /quan-tri. De trong thi trang do chi xem duoc.
# Dat mot chuoi dai va ngau nhien, vi ai co no la doi duoc noi lay phim cua ca he thong.
ADMIN_TOKEN=

# --- TheMovieDB (khong bat buoc) ---------------------------------------------
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
# ISP chan api.themoviedb.org (SNI/DPI)? Tro qua Cloudflare Worker proxy - xem
# tmdb-proxy/README.md. De trong thi goi thang TMDB.
TMDB_BASE_URL=
TMDB_IMAGE_BASE_URL=

# --- gioi han RAM (khong bat buoc) -------------------------------------------
# Tri mac dinh trong docker-compose.prod.yml hop cho VPS 2GB - muc "on ap".
# Do that: ba container luc nhan roi ~361 MiB (backend 245 + web 105 + dns 11).
# Chi dat may dong duoi neu ban chay VPS 1GB va muon that chac:
#   BACKEND_MEM_LIMIT=640m
#   JAVA_OPTS=-Xmx384m
#   WEB_MEM_LIMIT=384m
# Tren VPS >=4GB thi de trong, tri mac dinh da du.
#BACKEND_MEM_LIMIT=1g
#JAVA_OPTS=-Xmx640m
#WEB_MEM_LIMIT=512m
