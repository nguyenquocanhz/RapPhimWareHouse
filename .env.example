# Chep tep nay thanh .env roi sua cho hop voi may cua ban.
#   cp .env.example .env

# --- dia chi nhin tu trinh duyet cua nguoi xem -------------------------------
# Tren homelab thi dung dia chi cua may do. Hai dong nay quan trong: dia chi API bi
# nhung thang vao ma luc build, con dia chi web duoc backend dung de mo CORS.
PUBLIC_API_URL=http://192.168.100.169:8081
PUBLIC_WEB_URL=http://192.168.100.169:3000

# --- cong dua ra ngoai -------------------------------------------------------
# 8080 tren homelab da co ZCloud dung, nen backend ra o 8081.
BACKEND_PORT=8081
WEB_PORT=3000

# --- kho phim rieng (ZCloud) -------------------------------------------------
# Khong dat khoa vao tep nay neu ban co y dinh chia se no.
ZCLOUD_API_KEY=
ZCLOUD_PASSWORD=
ZCLOUD_PREFIX=
# ZCloud chay tren chinh may chu, khong phai trong Docker.
ZCLOUD_BASE_URL=http://host.docker.internal:8080

# --- TheMovieDB (khong bat buoc) ---------------------------------------------
TMDB_ACCESS_TOKEN=
TMDB_API_KEY=
